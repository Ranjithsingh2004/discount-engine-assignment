# Required for the natural-language rule input (Task 2).
# Free key from Google AI Studio: https://aistudio.google.com/apikey (no card needed).
# Only ever read server-side; it never reaches the browser.
GEMINI_API_KEY=

# Optional: a different Gemini model (default: gemini-3.5-flash-lite)
# LLM_MODEL=gemini-3.5-flash-lite

# Optional: any other OpenAI-compatible provider that supports JSON-schema output
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
